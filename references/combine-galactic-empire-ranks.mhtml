@charset "utf-8";

body, #mw-page-base { background-color: rgb(0, 31, 51); background-image: n=
one; }

#content { background-color: rgb(12, 50, 72); border-color: rgb(170, 170, 1=
70); }

.mw-body { margin-top: 0px; color: rgb(204, 204, 204); }

.mw-editinginterface, .mw-editform { color: rgb(34, 34, 34); }

.mw-content-ltr, .mw-editinginterface { color: rgb(204, 204, 204) !importan=
t; }

#left-navigation { margin-left: 11.5em; }

h1, h2, h3, h4, h5 { color: rgb(204, 204, 204); }

.vector-menu-tabs-legacy div.vector-menu-content .vector-menu-content-list =
li { border-width: 1px 1px medium; border-style: solid solid none; border-c=
olor: rgb(170, 170, 170) rgb(170, 170, 170) currentcolor; background-color:=
 rgb(0, 31, 51); box-sizing: border-box; }

#mw-head div.vector-menu-content .vector-menu-content-list li { background-=
color: rgb(0, 31, 51); color: rgb(204, 204, 204); background-image: none; }

#mw-head div.vector-menu content .vector-menu-content-list li a { }

#mw-head div.vector-menu-content .vector-menu-content-list li.selected { ba=
ckground-color: rgb(12, 50, 72); color: rgb(204, 204, 204); background-imag=
e: none; }

.vector-legacy-sidebar .vector-menu-content { background-color: rgb(0, 19, =
44); color: black; border: 1px solid rgb(204, 204, 204); padding: 0px 0.8em=
 0.3em 0.5em; background-image: none; }

div#mw-panel div.portal h3 { background: transparent; padding: 0px 1em 0px =
0.5em; display: inline; height: 1em; text-transform: lowercase; font-size: =
75%; font-weight: normal; white-space: nowrap; color: rgb(204, 204, 204); }

div#simpleSearch { background-image: none; background-color: unset; }

div#simpleSearch input { background-color: rgb(0, 19, 44); color: rgb(204, =
204, 204); }

a, a:visited, div#mw-panel div.portal div.body ul li a, div#mw-panel div.po=
rtal div.body ul li a:visited, .tocnumber, .vector-legacy-sidebar .vector-m=
enu-portal .vector-menu-content li a, .vector-legacy-sidebar .vector-menu-p=
ortal .vector-menu-content li a:visited { text-decoration: none; color: rgb=
(85, 121, 139); background: none; }

.vector-legacy-sidebar .vector-menu-portal .vector-menu-heading { color: rg=
b(204, 204, 204); }

.vector-menu-tabs-legacy a, .vector-menu-tabs-legacy a:visited, .vector-men=
u-tabs-legacy .selected a, .vector-menu-tabs-legacy .selected a:visited { c=
olor: rgb(204, 204, 204) !important; }

#bodyContent a.external { color: rgb(85, 121, 139); }

#toc, .toc, .mw-warning { border: 1px solid rgb(204, 204, 204); background-=
color: rgb(12, 50, 72); padding: 5px; font-size: 95%; }

table { background-color: rgb(0, 31, 51); }

pre { padding: 1em; border: 1px dashed rgb(204, 204, 204); color: rgb(204, =
204, 204); background-color: rgb(12, 50, 72); line-height: 1.1em; }

.catlinks { border: 1px solid rgb(204, 204, 204); background-color: rgb(12,=
 50, 72); padding: 5px; margin-top: 1em; clear: both; }

div#footer ul li { color: rgb(204, 204, 204); }

#pagehistory li.selected { background-color: unset; }

table, table.wikitable, div.thumbinner, img.thumbimage { background-color: =
rgb(0, 31, 51); color: rgb(204, 204, 204); }

#pagehistory li.selected { color: inherit; }

.mw-editinginterface, .mw-editform { color: inherit; }

#filetoc { background-color: inherit; }

table.wikitable > tr > th, table.wikitable > * > tr > th { background-color=
: inherit; }

.mw-parser-output a.extiw, .mw-parser-output a.extiw:active { color: rgb(85=
, 121, 139) !important; }
